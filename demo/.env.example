# LangChain 精简版环境变量模板
# 复制为 .env 后按需修改（本目录 .env 不入 git）

# ---- 引擎通道（默认 opencode CLI，视觉模型 MiMo-V2.5 Free）----
# opencode CLI：本机免费，支持视觉模型读图（admin 可在引擎配置界面切换）
OPENCODE_BIN=/Users/ethan/.opencode/bin/opencode
# 识别/审核默认模型（完整 provider/model 名，opencode 需要全名）
OPENCODE_RECOGNITION_MODEL=opencode/mimo-v2.5-free
OPENCODE_AUDIT_MODEL=opencode/mimo-v2.5-free

# CodeBuddy CLI（备选引擎，本机免费多模态）：二进制路径 + 视觉模型
CODEBUDDY_BIN=/Users/ethan/.nvm/versions/node/v24.16.0/bin/codebuddy
CODEBUDDY_MODEL=minimax-m3-pay
# 读图需要放行：bypassPermissions（等价 codebuddy -y），否则 Read 工具会拦截临时目录图片
CODEBUDDY_PERMISSION_MODE=bypassPermissions

# Qwen-VL 备用引擎（DashScope；免费额度可能耗尽，仅降级用）
DASHSCOPE_API_KEY=
QWEN_VL_MODEL=qwen-vl-plus

# ---- 审核 Agent ----
# 审核模型：cross_audit 模式下与识别模型不同家族（盲点互补）
AUDIT_MODEL=opencode/mimo-v2.5-free

# ---- 自定义 OpenAI 兼容引擎（admin 界面填写，见下）----
# 也可通过环境变量提供默认值：
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# ---- 存储 ----
DB_PATH=./receipt_demo.db

# ---- 鉴权 / 预览 URL 签名密钥 ----
# 保护对象：登录 token 的 HMAC 签名 + 单据原图预览 URL 的 &sig= 签名
# （GET /api/receipt/{id}/image 匿名可取图，靠该签名阻止遍历自增 id 枚举原图）。
# 不设的后果：使用仓库内置默认值 demo-token-secret-dev-only，任何知道默认值的人都能
#   自行伪造签名遍历单据 id 取图；生产环境（ENV/APP_ENV=production）启动时会打 WARNING，
#   开发/演示环境不受影响。
# 生产请显式设为随机长字符串，例如：openssl rand -hex 32
# 注意：更换该值会让既有已签发的预览 URL 与 token 立即失效（重新拉取列表即可恢复）。
DEMO_TOKEN_SECRET=
