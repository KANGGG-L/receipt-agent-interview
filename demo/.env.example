# LangChain 精简版环境变量模板
# 复制为 .env 后按需修改（本目录 .env 不入 git）
#
# 本模板已按「代码实际读取的键」逐项核对（grep `os.environ` / `os.getenv` 全量比对），
# 空值表示沿用代码内默认值。未被任何代码读取的键不在此列。

# ---- 已删除：本机 CLI 引擎（2026-09-02 弃用）----
# 原先此处有 OPENCODE_BIN / CODEBUDDY_BIN / CODEBUDDY_MODEL / CODEBUDDY_PERMISSION_MODE
# 四个键，对应两个本机 CLI 识别引擎。这两个引擎已于 2026-09-02 弃用：相关的模型类、
# 常驻进程管理器（app/engine_runtime.py）、ai_registry 插件与 EngineKind 枚举成员
# 均已从代码中删除，键留着也无人读取，故一并移除。不要再设置它们。
#
# 已废弃（勿再设置）：OPENCODE_RECOGNITION_MODEL / OPENCODE_AUDIT_MODEL
# 这两个键在任何应用代码里都零读取（历史重命名残留）。识别模型请改用 RECOGNITION_MODEL /
# OPENAI_REC_MODEL；审核模型请改用 SILICONFLOW_AUDIT_MODEL / OPENAI_AUD_MODEL。
# AUDIT_MODEL 只是「SILICONFLOW_AUDIT_MODEL 未设」时的历史回退别名；写 opencode/codebuddy
# 前缀的模型名会被 models.is_legacy_cli_model 判为无效并丢弃（回落内置默认）。

# ---- 识别 / 审核引擎（OpenAI 兼容通道）----
# 引擎类型：openai（当前唯一通道，OpenAI 兼容 HTTP）。历史注记：EngineKind 原有
# opencode / codebuddy 两个本机 CLI 成员，已于 2026-09-02 弃用删除。
RECOGNITION_ENGINE=openai
# 识别模型（默认 DashScope qwen3.5-omni-flash）
RECOGNITION_MODEL=
# 审核引擎类型 + 审核模型（默认 SF zai-org/GLM-4.5V；与识别腿刻意分家族以互补盲点）
AUDIT_ENGINE=openai
# AUDIT_MODEL 是历史回退别名（新配置勿用），仅在 SILICONFLOW_AUDIT_MODEL 未设时生效。
# 曾一度被写成 opencode/mimo-v2.5-free —— 那是已弃用 CLI 引擎的模型名，会让审核腿
# 带着 opencode 模型名去打 SiliconFlow 通道（必然失败）。留空 = 沿用内置默认。
AUDIT_MODEL=

# ---- 自定义 OpenAI 兼容引擎（admin 界面填写，见下）----
# 旧式通用键：作为审核腿 / 解析腿 base、key、模型的兜底来源
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# 识别腿（rec）专属：base / key / model，优先级高于上面的通用键
OPENAI_REC_BASE_URL=
OPENAI_REC_API_KEY=
OPENAI_REC_MODEL=
# 识别腿 completion 预算上限：推理型模型思考段同耗预算，写死 4000 时长图任务会
# finish_reason=length、content 空。留空 = 4000 原口径；非法值忽略。
OPENAI_REC_MAX_TOKENS=
# 识别腿传输超时（秒）：离线批量评推理型模型（单张实测 ~56s）会被 60s 硬顶掐断。
# 留空 = 引擎 call_timeout 原口径；硬顶 600s（min(值,600)）。
OPENAI_REC_CALL_TIMEOUT=
# 审核腿（aud）专属：未设时依次回落 OPENAI_* / SILICONFLOW_API_KEY
OPENAI_AUD_BASE_URL=
OPENAI_AUD_API_KEY=
OPENAI_AUD_MODEL=
# 解析腿（parse，解析级修正）专属：未设时回落 OPENAI_*
OPENAI_PARSE_BASE_URL=
OPENAI_PARSE_API_KEY=
OPENAI_PARSE_MODEL=

# ---- DashScope：识别腿的默认 provider（不是备用通道！）----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 审核腿降级到 DashScope 时用的审核模型
DASHSCOPE_AUDIT_MODEL=
# 识别模型；留空 = 内置默认 qwen3.5-omni-flash
# （不要写 qwen-vl-plus：旧模板这么写，与代码默认漂移）
QWEN_VL_MODEL=

# ---- SiliconFlow：审核腿的默认 provider（与识别腿跨厂商异构，Gap A3）----
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
# 识别腿降级到 SiliconFlow 时用的识别模型
SILICONFLOW_MODEL=
# 审核模型；留空 = 内置默认 zai-org/GLM-4.5V
SILICONFLOW_AUDIT_MODEL=

# ---- 存储 ----
DB_PATH=./receipt_demo.db
# 备份脚本输出目录（默认 <demo>/backups）
BACKUP_DIR=

# ---- 鉴权 / 预览 URL 签名密钥 ----
# 保护对象：登录 token 的 HMAC 签名 + 单据原图预览 URL 的 &sig= 签名
# （GET /api/receipt/{id}/image 与 GET /api/payment/voucher/{name} 匿名可取图——浏览器
#  原生 <img>/<a> 带不了请求头，靠 &sig=（绑定 单据 id / 凭证名 + 租户）阻止枚举）。
# 不设的后果：使用仓库内置默认值 demo-token-secret-dev-only，
#   - AUTH_ENABLED=1（生产鉴权）：启动直接 RuntimeError 拒绝启动（见 auth.enforce_production_secret）；
#   - AUTH_ENABLED=0（开发/演示）：服务照常可用，但签名**只防误撞、不防构造**——密钥是
#     仓库公开常量，任何读过源码的人都能自行签发任意单据/凭证/租户的合法 sig，此时签名
#     不构成访问控制（真正的边界是租户归属校验与文件路径收敛）。
#   该事实可通过 GET /api/health 的 "signature_secret_weak": true 一眼看到（密钥已配置时为
#   false）；生产（ENV/APP_ENV=production）另打一条启动 WARNING。
# 生产请显式设为随机长字符串，例如：openssl rand -hex 32
# 注意：更换该值会让既有已签发的预览 URL 与 token 立即失效（重新拉取列表即可恢复）。
DEMO_TOKEN_SECRET=
# 是否启用登录鉴权：0/false（默认开发态关闭）/ 1/true/yes
AUTH_ENABLED=0

# ---- 运行环境与调试 ----
# 运行环境标识（production 会启用生产相关告警与校验）；ENV 优先于 APP_ENV
ENV=development
APP_ENV=development
# 单次引擎调用超时（秒）。写入口会钳到上限 60（见 app.models.MAX_CALL_TIMEOUT_SECONDS）
ENGINE_CALL_TIMEOUT=
# 仅测试用：置 1 时 mock qwen3-vl-flash 的响应，避免真调用
MOCK_QWEN_FLASH=

# ---- 特性开关 / 阈值（多数另有管理台 app_settings 实时值，此处为进程级覆写）----
# 识别 prompt 版本（留空用代码默认；评测 run_eval --prompt 走同一版本机制）
EXTRACT_PROMPT_VERSION=
# 实验守护巡检间隔（分钟）
GUARDIAN_INTERVAL_MINUTES=
# RAG 记忆向量库持久化目录
RAG_DIR=./.rag_chroma
# RAG 记忆嵌入档：hash（缺省，离线确定性 char-2/3-gram，256 维）/ siliconflow
# （BAAI/bge-m3，1024 维，用 OPENAI_BASE_URL+OPENAI_API_KEY 或 SILICONFLOW_*）/
# dashscope（text-embedding-v4，1024 维，需 DASHSCOPE_*）。切档即新建集合
# （集合名带 provider:model:dim 后缀，不混写）；档位非法或凭据不成对直接报错，
# 远端档探测失败会留 warning 并回落，不会静默换档。当前生效档见集合名。
RAG_EMBEDDING_PROVIDER=hash
# 评测语料目录（默认 <demo>/evalsets）
EVALSET_DIR=
